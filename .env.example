# Demonstration only. Copy to .env in the repository root.
RUNTU_PLATFORM_NAME="Runtu Platform"
# Empty disables database access. For an isolated local PostgreSQL database only:
# RUNTU_DATABASE_URL="postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/runtu_dev"
RUNTU_DATABASE_URL=
# Authentication remains unavailable until both DB and exact public origin are configured.
# RUNTU_AUTH_ORIGIN="https://your-reviewed-host.example"
RUNTU_AUTH_ALLOW_LOOPBACK_HTTP=false
RUNTU_AUTH_SESSION_SECONDS=3600
RUNTU_AUTH_IDLE_SECONDS=900
RUNTU_EXPOSE_API_DOCS=false
